# 8-Bit Music Box instruments: strings
#
# Strings: saw waves, a quick bow attack, vibrato arriving late. The contrabass
# is a dark pulse with some saw in it; the harp is a plucked triangle.
#
# In 32-bit mode the four bowed strings play a simulated bowed string instead
# (`model bowed`) through their body's resonances (`resonance`: Hz, Q, dB).
# The resonances are rough, by ear and from published measurements of the
# instruments' main body modes - adjust them freely.
#
# The format is described in README.txt in this folder. Ranges are sounding
# pitch (what you hear), not the written pitch of transposing instruments.

define_instrument violin
name "Violin"
family strings
range G3 G7
wave saw
layer none
envelope 0.03 0.1 0.85 0.08
vibrato 5.8 0.14 0.18
sweep 0 0
breath 0.02
tone 0.55
metallic 0
gain 0.55
pan -0.45
color 236 112 84
# 32-bit mode: bowed-string model and body (see the cello).
model bowed 0.5 0.12
resonance 280 3 4
resonance 480 3 4
resonance 2500 1.2 4
resonance 6500 0.7 -8
end

define_instrument viola
name "Viola"
family strings
range C3 E6
wave saw
layer none
envelope 0.04 0.1 0.85 0.1
vibrato 5.5 0.13 0.2
sweep 0 0
breath 0.02
tone 0.42
metallic 0
gain 0.55
pan 0.1
color 232 146 70
# 32-bit mode: bowed-string model and body (see the cello).
model bowed 0.5 0.12
resonance 230 3 4
resonance 400 3 4
resonance 2000 1.2 3
resonance 5500 0.7 -8
end

# Range: the cello's full compass, C2 (open C string) to C6, two octaves above
# middle C. A5 - two octaves above the open A string - is the usual limit in
# orchestral parts; solo music goes on up to C6.
define_instrument cello
name "Cello"
family strings
range C2 C6
wave saw
layer none
envelope 0.05 0.12 0.85 0.12
vibrato 5.2 0.12 0.22
sweep 0 0
breath 0.015
tone 0.32
metallic 0
gain 0.6
pan 0.35
color 200 70 130
# 32-bit mode: a simulated bowed string, and the body's main resonances -
# the air in the box, the two main wood modes, the bridge - with the harsh
# top of the bowed string taken down.
model bowed 0.5 0.12
resonance 105 3 5
resonance 200 3 4
resonance 2200 1.2 3
resonance 5000 0.7 -9
end

define_instrument contrabass
name "Contrabass"
family strings
range E1 G4
wave pulse 0.5
layer saw 0.4 0
envelope 0.05 0.15 0.8 0.12
vibrato 4.8 0.08 0.3
sweep 0 0
breath 0
tone 0.22
metallic 0
gain 0.7
pan 0.55
color 176 70 58
# 32-bit mode: bowed-string model and body (see the cello).
model bowed 0.5 0.13
resonance 60 3 5
resonance 110 3 4
resonance 1200 1.2 3
resonance 3500 0.7 -8
end

define_instrument harp
name "Harp"
family strings
range C1 G7
wave triangle
layer pulse 0.15 12
envelope 0.002 1.6 0 0.4
vibrato 0 0 0
sweep 0 0
breath 0
tone 0.7
metallic 0
gain 0.7
pan -0.6
color 246 190 120
end
