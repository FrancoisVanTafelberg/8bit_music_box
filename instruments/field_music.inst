# Field music: the instruments of an 18th-century fife-and-drum corps that the
# built-in orchestra does not already have. An example of the format - see
# README.txt.

# The bugle: a valveless brass horn that can only play its natural harmonics,
# which is why bugle calls use so few notes. Brighter and blunter than the
# trumpet it is based on, with no vibrato.
define_instrument bugle
based_on trumpet
name "Bugle"
range C4 G5
wave pulse 0.5
layer saw 0.35 0
envelope 0.012 0.1 0.8 0.05
vibrato 0 0 0
sweep -0.8 0.025
tone 0.75
gain 0.5
color 255 176 64
end

# A second, softer fife for the lower part, so two fife lines are easy to
# tell apart.
define_instrument fife_low
based_on fife
name "Fife (2nd)"
wave pulse 0.5
layer triangle 0.7 0
breath 0.07
tone 0.7
gain 0.42
pan -0.1
color 160 210 90
end
