# 8-Bit Music Box instruments: woodwinds
#
# Woodwinds: triangles that breathe, and pulses of every width - 12.5 % is
# nasal (oboe), 25 % bright (bassoon), 50 % hollow (clarinet, whose real
# overtones are odd-numbered like a square wave's).
#
# The format is described in README.txt in this folder. Ranges are sounding
# pitch (what you hear), not the written pitch of transposing instruments.

define_instrument piccolo
name "Piccolo"
family woodwinds
range D5 C8
wave triangle
layer none
envelope 0.02 0.1 0.8 0.06
vibrato 6 0.1 0.15
sweep 0 0
breath 0.07
tone 0.8
metallic 0
gain 0.55
pan -0.2
color 150 230 120
end

# The fife: the six-hole wooden flute of the fife-and-drum corps. Shriller
# and plainer than the piccolo - a brighter pulse under the breath, and no
# vibrato, because fifers played dead straight.
define_instrument fife
name "Fife"
family woodwinds
range D5 D7
wave pulse 0.25
layer triangle 0.55 0
envelope 0.012 0.06 0.85 0.04
vibrato 0 0 0
sweep 0 0
breath 0.09
tone 0.85
metallic 0
gain 0.45
pan -0.25
color 196 236 96
end

define_instrument flute
name "Flute"
family woodwinds
range C4 C7
wave triangle
layer sine 0.3 0
envelope 0.035 0.1 0.85 0.08
vibrato 5.5 0.12 0.2
sweep 0 0
breath 0.06
tone 0.75
metallic 0
gain 0.75
pan -0.15
color 120 214 110
end

define_instrument oboe
name "Oboe"
family woodwinds
range A#3 G6
wave pulse 0.125
layer none
envelope 0.025 0.08 0.8 0.06
vibrato 5.2 0.08 0.2
sweep 0 0
breath 0
tone 0.6
metallic 0
gain 0.45
pan 0.15
color 92 196 140
end

define_instrument english_horn
name "English Horn"
family woodwinds
range E3 C6
wave pulse 0.125
layer none
envelope 0.03 0.1 0.8 0.08
vibrato 5 0.08 0.22
sweep 0 0
breath 0
tone 0.4
metallic 0
gain 0.5
pan 0.2
color 70 170 120
end

define_instrument clarinet
name "Clarinet"
family woodwinds
range D3 A#6
wave pulse 0.5
layer none
envelope 0.03 0.1 0.85 0.06
vibrato 0 0 0
sweep 0 0
breath 0.01
tone 0.5
metallic 0
gain 0.45
pan -0.1
color 160 206 70
end

define_instrument bass_clarinet
name "Bass Clarinet"
family woodwinds
range D2 F5
wave pulse 0.5
layer none
envelope 0.035 0.1 0.85 0.08
vibrato 0 0 0
sweep 0 0
breath 0.01
tone 0.3
metallic 0
gain 0.5
pan -0.05
color 120 160 60
end

define_instrument bassoon
name "Bassoon"
family woodwinds
range A#1 D#5
wave pulse 0.25
layer none
envelope 0.03 0.1 0.8 0.07
vibrato 4.8 0.05 0.25
sweep 0 0
breath 0
tone 0.3
metallic 0
gain 0.5
pan 0.1
color 100 150 90
end

define_instrument contrabassoon
name "Contrabassoon"
family woodwinds
range A#0 F3
wave pulse 0.25
layer none
envelope 0.04 0.1 0.8 0.08
vibrato 0 0 0
sweep 0 0
breath 0
tone 0.2
metallic 0
gain 0.6
pan 0.1
color 80 120 70
end
