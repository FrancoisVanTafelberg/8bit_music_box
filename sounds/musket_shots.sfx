# Musket shots: ten of them, to pick from (the SFX tester's < > on the Musket
# button) or to mix in a volley so no two shots sound alike.
#
# Modelled on a recording of muskets firing (.temp/samples/muskets firing.m4a,
# not kept in the repo): each of shots 1-8 was fitted, voice by voice, to one
# shot in it - the second it is at is given - by rendering candidates through
# this synth and matching the real shot's loudness in eight octave bands every
# 4 ms. 9 and 10 are built from them. The long roll after each is kept at about
# the level the clean shots in the recording die away at.
#
# What a musket shot is made of, and the voices here:
#   flash  the priming powder in the pan going up, a hiss just before the
#          charge (flintlocks only: shots 6 and 10)
#   crack  the first instant: bright noise, a few milliseconds
#   boom   the pressure wave: two or three cycles of a very low sine (50-75 Hz)
#          that falls in pitch as it goes - most of a shot's weight
#   body   the blast: noise, mid to dark, a tenth of a second or so
#   tail   the roll of the report off the field and the trees: dark, slow
#
# Every shot has its own instruments (msN_...), as each needs its own decay.
# All in group "musket", with the original musket in battle.sfx.

# --- 1: close and heavy: a big, slow boom (modelled on the shot at 68.8 s) ---

define_instrument ms1_crack
family percussion
gain 1
wave noise
envelope 0.0005 0.0081 0 0.005
tone 0.2
end

define_instrument ms1_boom
family percussion
gain 1
wave sine
envelope 0.006 0.13 0 0.02
sweep 23 0.007
end

define_instrument ms1_body
family percussion
gain 1
wave noise
envelope 0.001 0.069 0 0.02
tone 0.035
end

define_instrument ms1_tail
family percussion
gain 1
wave noise
envelope 0.06 0.89 0 0.05
tone 0.18
end

define_sfx musket_shot_1
name "Musket 1"
group musket
voice ms1_crack  D#7   0      0.01 2.4
voice ms1_boom   69hz  0      0.01 1.3
voice ms1_body   G8    0      0.01 1.1
voice ms1_tail   G8    0.0089 0.01 0.46
end

